{
	"name": "sauciety",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.11.0",
	"scripts": {
		"dev": "vite --host",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": "eslint --fix",
		"*.{js,ts,svelte,css,scss,json,md,yml,yaml}": "prettier --write"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.69.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.4",
		"@tailwindcss/vite": "^4.3.2",
		"@types/node": "^26.1.0",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.7.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"prettier": "^3.9.4",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"sass": "^1.101.0",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.1",
		"svelte-eslint-parser": "^1.8.0",
		"svelte-preprocess": "^6.0.5",
		"tailwindcss": "^4.3.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.63.0",
		"vite": "^8.1.3"
	},
	"dependencies": {
		"@auth/sveltekit": "^1.11.2",
		"@lucide/svelte": "^1.23.0",
		"mongodb": "^7.4.0",
		"svelte-easy-crop": "^5.0.1",
		"svelte-heros": "^8.0.1"
	}
}
